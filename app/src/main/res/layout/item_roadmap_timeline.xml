<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="90dp"
    android:paddingVertical="6dp">

    <!-- 왼쪽 사진 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/photoContainer"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="2dp"
        app:strokeColor="#33000000"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp">

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/sample_food"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- 사진과 카드 사이 정중앙 가이드라인 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideTimeline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.285" />

    <!-- 위쪽 선 -->
    <View
        android:id="@+id/lineTop"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#33000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dot"
        app:layout_constraintStart_toStartOf="@id/guideTimeline"
        app:layout_constraintEnd_toEndOf="@id/guideTimeline"
        android:visibility="gone" />

    <!-- 점 -->
    <View
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_small"
        app:layout_constraintTop_toTopOf="@id/photoContainer"
        app:layout_constraintBottom_toBottomOf="@id/photoContainer"
        app:layout_constraintStart_toStartOf="@id/guideTimeline"
        app:layout_constraintEnd_toEndOf="@id/guideTimeline"
        android:visibility="gone" />

    <!-- 아래쪽 선 -->
    <View
        android:id="@+id/lineBottom"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#33000000"
        app:layout_constraintStart_toStartOf="@id/guideTimeline"
        app:layout_constraintEnd_toEndOf="@id/guideTimeline"
        app:layout_constraintTop_toBottomOf="@id/dot"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"/>

    <!-- 화살표 -->
    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_arrow_down"
        app:layout_constraintStart_toStartOf="@id/guideTimeline"
        app:layout_constraintEnd_toEndOf="@id/guideTimeline"
        app:layout_constraintBottom_toTopOf="@id/dot"
        android:layout_marginBottom="-3dp"
        android:visibility="gone"
        app:tint="#33000000" />



    <!-- 오른쪽 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:strokeColor="#22000000"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toEndOf="@id/photoContainer"
        app:layout_constraintTop_toTopOf="@id/photoContainer"
        app:layout_constraintBottom_toBottomOf="@id/photoContainer"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:text="맥도날드" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#555"
                android:textSize="12sp"
                tools:text="경기도 수원시 영통구 아주로 46" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#555"
                android:textSize="12sp"
                tools:text="전화번호: 031-000-0000" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
